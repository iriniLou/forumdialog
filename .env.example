# Leave both unset to use isolated browser-local DEMO data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Actual HTTPS frontend origin, only after deployment. Enables participant QR.
VITE_PUBLIC_ORIGIN=
# Automatically set by GitHub Actions for real publication; never contains secrets.
VITE_REQUIRE_BACKEND=false
VITE_EVENT_CODE=DEMO
# /forumdialog/ for GitHub Pages; / for Vercel or Netlify.
VITE_BASE_PATH=/
